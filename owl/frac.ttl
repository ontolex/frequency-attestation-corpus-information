@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix synsem: <http://www.w3.org/ns/lemon/synsem#> .
@prefix decomp: <http://www.w3.org/ns/lemon/decomp#> .
@prefix vartrans: <http://www.w3.org/ns/lemon/vartrans#> .
@prefix lime: <http://www.w3.org/ns/lemon/lime#> .
@prefix lexicog: <http://www.w3.org/ns/lemon/lexicog#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .

<http://www.w3.org/ns/lemon/frac#>
    a voaf:Vocabulary, owl:Ontology .

frac:Collocation
    a owl:Class ;
    rdfs:comment "Collocation is an Observation that describes the co-occurrence of two or more observables within the same context window and that can be characterized by their weight (RDF value) and by collocation scores in a particular data source (observed in)."@en ;
    rdfs:label "Collocation"@en ;
    rdfs:subClassOf rdfs:Container, frac:Observation, [
        a owl:Restriction ;
        owl:allValuesFrom frac:Observable ;
        owl:onProperty rdfs:member
    ], [
        a owl:Restriction ;
        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
        owl:onClass frac:Observable ;
        owl:onProperty rdfs:member
    ], [
        a owl:Restriction ;
        owl:maxCardinality 1 ;
        owl:onProperty frac:head
    ] .

frac:LexicalAttestation
    a owl:Class ;
    rdfs:comment "Lexical attestation is an Observation that represents one exact or normalized quotation or excerpt from a source document that illustrates a particular form, sense, lexeme or features such as spelling variation, morphology, syntax, collocation, register."@en ;
    rdfs:label "Lexical Attestation"@en ;
    rdfs:subClassOf frac:Observation, [
        a owl:Restriction ;
        owl:maxCardinality 1 ;
        owl:onProperty frac:quotedText
    ] .

frac:Observable
    a owl:Class ;
    rdfs:comment "Observable is a superclass for any element of a lexical resource that frequency, attestation or corpus-derived information can be expressed about. This includes, among others, lexical entry, lexical sense, form, and lexical concept. Elements that FrAC properties apply to must be observable in a corpus or another linguistic data source."@en ;
    rdfs:label "Observable"@en .

frac:ObservableFrequency
    a owl:Class ;
    rdfs:comment "Observable frequency is an Observation of the absolute number of attestations (RDF value) of a particular observable (see frequency property) that is observed in a particular data source (observed in). Using unit, frequency objects can also identify the (segmentation) unit that their counts are based on."@en ;
    rdfs:label "Observable Frequency"@en ;
    rdfs:subClassOf frac:Observation, [
        a owl:Restriction ;
        owl:cardinality 1 ;
        owl:onProperty frac:observedIn
    ], [
        a owl:Restriction ;
        owl:cardinality 1 ;
        owl:onProperty rdf:value
    ] .

frac:Observation
    a owl:Class ;
    rdfs:comment "Observation is a superclass for anything that can be observed in a corpus about an observable."@en ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:cardinality 1 ;
        owl:onProperty frac:observedIn
    ], [
        a owl:Restriction ;
        owl:cardinality 1 ;
        owl:onProperty rdf:value
    ] .

frac:attestation
    a owl:ObjectProperty ;
    rdfs:comment "The attestation property associates an attestation to the observable."@en ;
    rdfs:domain frac:Observable ;
    rdfs:label "Attestation"@en ;
    rdfs:range frac:LexicalAttestation .

frac:cScore
    a owl:DatatypeProperty ;
    rdfs:comment "Collocation score provides the value for one specific type of collocation score for a particular collocation in its respective corpus. Note that this property should not be used directly, but instead, its respective sub-properties for scores of a particular type."@en ;
    rdfs:domain frac:Collocation ;
    rdfs:label "Collocation Score"@en .

frac:frequency
    a owl:ObjectProperty ;
    rdfs:comment "The frequency property assigns a particular observable an observable frequency."@en ;
    rdfs:domain frac:Observable ;
    rdfs:label "Frequency"@en ;
    rdfs:range frac:ObservableFrequency .

frac:head
    a owl:ObjectProperty ;
    rdfs:comment "The head property identifies the element of a collocation that its scores are about. A collocation must not have more than one head."@en ;
    rdfs:domain frac:Collocation ;
    rdfs:label "Head"@en ;
    rdfs:range frac:Observable .

frac:locus
    a owl:ObjectProperty ;
    rdfs:comment "locus points to the location at which the relevant word(s) can be found."@en ;
    rdfs:domain frac:LexicalAttestation ;
    rdfs:label "Locus"@en .

frac:observedIn
    a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "For an Observation, the observed in property defines the URI of the data source (or its metadata entry) that this particular observation was made in or derived from. This can be, for example, a corpus or a text represented by its access URL, a book represented by its bibliographical metadata, etc."@en ;
    rdfs:domain frac:Observation ;
    rdfs:label "Observed In"@en .

frac:quotedText
    a owl:DatatypeProperty ;
    rdfs:comment "The quoted text property provides the text of the attestation."@en ;
    rdfs:domain frac:LexicalAttestation ;
    rdfs:label "Quoted Text"@en ;
    rdfs:range rdf:PlainLiteral .

frac:total
    a owl:ObjectProperty ;
    rdfs:comment "The object property total assigns any potential FrAC data source (i.e., Dublin Core Collection, Dublin Core Dataset, Dublin Core Text or any other member of DCMI Type) the total number of elements that it contains as an observable frequency object."@en ;
    rdfs:domain [
        a owl:Restriction ;
        owl:onProperty rdf:type ;
        owl:someValuesFrom [
            a owl:Restriction ;
            owl:hasValue dct:DCMIType ;
            owl:onProperty dcam:memberOf
        ]
    ] ;
    rdfs:label "Total"@en ;
    rdfs:range frac:ObservableFrequency .

frac:unit
    a owl:ObjectProperty ;
    rdfs:comment "For an observable frequency object, the property unit provides an identifier of the respective segmentation unit."@en ;
    rdfs:domain frac:ObservableFrequency ;
    rdfs:label "Unit"@en .

ontolex:Form
    rdfs:subClassOf frac:Observable .

ontolex:LexicalConcept
    rdfs:subClassOf frac:Observable .

ontolex:LexicalEntry
    rdfs:subClassOf frac:Observable .

ontolex:LexicalSense
    rdfs:subClassOf frac:Observable .

