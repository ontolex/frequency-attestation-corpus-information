@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .


##########################
# vocabulary declaration #
##########################
<http://www.w3.org/ns/lemon/frac#>
    a owl:Ontology, voaf:Vocabulary .


#####################
# top-level classes #
#####################

frac:Observable
    a owl:Class ;
    rdfs:label "Observable"@en ;
    rdfs:comment "Observable is a superclass for any element of a lexical resource that frequency, attestation or corpus-derived information can be expressed about. This includes, among others, lexical entry, lexical sense, form, and lexical concept. Elements that FrAC properties apply to must be observable in a corpus or another linguistic data source."@en .

frac:Observation
    a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Observation is a superclass for anything that can be observed in a corpus about an observable."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty frac:observedIn ;
        owl:cardinality "1"^^xsd:integer
    ] , [
        a owl:Restriction ;
        owl:onProperty rdf:value ;
        owl:cardinality "1"^^xsd:integer
    ] .

frac:observedIn
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observedIn"@en ;
    rdfs:domain frac:Observation ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "For an Observation, the property observedIn defines the URI of the data source (or its metadata entry) that this particular observation was made in or derived from. This can be, for example, a corpus or a text represented by its access URL, a book represented by its bibliographical metadata, etc."@en .


#############
# frequency #
#############

frac:Frequency
    a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:comment "Frequency is an Observation of the absolute number of attestations (rdf:value) of a particular observable (see frequency property) that is observedIn in a particular data source. Using unit, frequency objects can also identify the (segmentation) unit that their counts are based on."@en ;
    rdfs:subClassOf frac:Observation , [
        a owl:Restriction ;
        owl:onProperty rdf:value ;
        owl:cardinality "1"^^xsd:integer
    ] , [
        a owl:Restriction ;
        owl:onProperty frac:observedIn ;
        owl:cardinality "1"^^xsd:integer
    ] .

frac:frequency
    a owl:ObjectProperty ;
    rdfs:label "frequency"@en ;
    rdfs:domain frac:Observable ;
    rdfs:range frac:Frequency ;
    rdfs:comment "The frequency property assigns a particular observable a Frequency."@en .

frac:unit
    a owl:ObjectProperty ;
    rdfs:label "unit"@en ;
    rdfs:domain frac:Frequency ;
    rdfs:comment "For a Frequency object, the property unit provides an identifier of the respective segmentation unit."@en .

# NOTE: frac:total's domain is specified in index.md as a formal restriction
# ("any class that is a dcam:memberOf DCMI Type"), but the RDFa-extraction
# pipeline currently fails to expand that <domain> tag (see issue #71 / PR
# #75, which fixes the extraction). Once that lands, this file should be
# regenerated to pick up the same rdfs:domain restriction.
frac:total
    a owl:ObjectProperty ;
    rdfs:label "total"@en ;
    rdfs:range frac:Frequency ;
    rdfs:comment "The object property total assigns any potential FrAC data source (i.e., dct:Collection, dct:Dataset, dct:Text or any other member of DCMI Type) the total number of elements that it contains as a Frequency object."@en .


###############
# attestation #
###############

frac:Attestation
    a owl:Class ;
    rdfs:label "Attestation"@en ;
    rdfs:comment "Attestation is an Observation that represents one exact or normalized quotation or excerpt from a source document that illustrates a particular form, sense, lexeme or features such as spelling variation, morphology, syntax, collocation, register."@en ;
    rdfs:subClassOf frac:Observation , [
        a owl:Restriction ;
        owl:onProperty frac:quotedText ;
        owl:maxCardinality "1"^^xsd:integer
    ] .

frac:attestation
    a owl:ObjectProperty ;
    rdfs:label "attestation"@en ;
    rdfs:domain frac:Observable ;
    rdfs:range frac:Attestation ;
    rdfs:comment "The attestation property associates an attestation to the observable."@en .

frac:quotedText
    a owl:DatatypeProperty ;
    rdfs:label "quotedText"@en ;
    rdfs:domain frac:Attestation ;
    rdfs:range xsd:string ;
    rdfs:comment "The quotedText property provides the text of the attestation as it is represented in the original source. This can be a plain text string, or a more complex representation, e.g., as an HTML fragment, or as a reference to a Web Annotation."@en .

frac:locus
    a owl:ObjectProperty ;
    rdfs:label "locus"@en ;
    rdfs:domain frac:Attestation ;
    rdfs:comment "locus points to the location at which the relevant word(s) can be found."@en .


###############
# collocation #
###############

frac:Collocation
    a owl:Class ;
    rdfs:label "Collocation"@en ;
    rdfs:comment "Collocation is an Observation that describes the co-occurrence of two or more observables within the same context window and that can be characterized by their collocation score (or weight, rdf:value) in a particular data source (observedIn)."@en ;
    rdfs:subClassOf rdfs:Container , frac:Observation , [
        a owl:Restriction ;
        owl:onProperty rdfs:member ;
        owl:allValuesFrom frac:Observable
    ] , [
        a owl:Restriction ;
        owl:onProperty rdfs:member ;
        owl:onClass frac:Observable ;
        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ;
        owl:onProperty frac:head ;
        owl:maxCardinality "1"^^xsd:integer
    ] .

frac:cScore
    a owl:DatatypeProperty ;
    rdfs:label "cScore"@en ;
    rdfs:domain frac:Collocation ;
    rdfs:subPropertyOf rdf:value ;
    rdfs:comment "Collocation score is a subproperty of rdf:value that provides the value for one specific type of collocation score for a particular collocation in its respective corpus. Note that this property should not be used directly, but instead, its respective sub-properties for scores of a particular type."@en .

frac:head
    a owl:ObjectProperty ;
    rdfs:label "head"@en ;
    rdfs:domain frac:Collocation ;
    rdfs:range frac:Observable ;
    rdfs:comment "The head property identifies the element of a collocation that its scores are about. A collocation must not have more than one head."@en .
